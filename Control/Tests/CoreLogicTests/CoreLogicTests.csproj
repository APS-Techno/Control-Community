<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputPath>$(ApsBinDir)tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../RecipeModel/RecipeModel.csproj" />
    <ProjectReference Include="../../APS.SystemControl.Framework.csproj" />
    <ProjectReference Include="../../HW_Libraries/S7/APS.Hardware.S7.csproj" />
    <ProjectReference Include="../../HW_Libraries/Demo/APS.Hardware.Demo.csproj" />
    <ProjectReference Include="..\..\GUI_Libraries\Generic\APS.Controls.Generic.csproj" />
    <ProjectReference Include="../../Workers/Generic/APS.Workers.Generic.csproj" />
    <ProjectReference Include="..\..\APS.SystemControl.Plugin\APS.SystemControl.Plugin.csproj" />
    <ProjectReference Include="..\..\..\Agent\APS.Agent.Core\APS.Agent.Core.csproj" />
    <ProjectReference Include="..\..\..\Agent\APS.Agent.Ui\APS.Agent.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
