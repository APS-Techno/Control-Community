<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>APS.Controls.Generic</AssemblyName>
    <RootNamespace>APS.Controls.Generic</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <OutputPath>$(ApsBinDir)GUI_LIB\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);WFO1000;WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreLogicTests" />
  </ItemGroup>

  <Target Name="PreventSharedDepCopying"
          BeforeTargets="_CopyFilesMarkedCopyLocal"
          DependsOnTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\APS.SystemControl.Framework.csproj" Private="false" />
    <ProjectReference Include="..\..\..\VacuumControls\VacuumControls.csproj" Private="false" />
    <ProjectReference Include="..\..\APS.ProcessPanel.Contracts\APS.ProcessPanel.Contracts.csproj" Private="false" />
    <ProjectReference Include="..\..\APS.SystemControl.Plugin\APS.SystemControl.Plugin.csproj" Private="false" />
  </ItemGroup>

</Project>
