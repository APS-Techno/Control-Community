<?xml version="1.0" encoding="utf-8"?>
<EmulatorConfig>
  <Engine TickIntervalMs="100" />
  <Protocols>
    <S7Server plcId="main" bindAddress="127.0.0.1" port="102" />

    <TcpSerial deviceId="PSU_A" bindAddress="127.0.0.1" port="5025" framing="LfTerminated" />
    <TcpSerial deviceId="PSU_B" bindAddress="127.0.0.1" port="5026" framing="LfTerminated" />
    <TcpSerial deviceId="PSU_C" bindAddress="127.0.0.1" port="5027" framing="LfTerminated" />
    <TcpSerial deviceId="PSU_ION" bindAddress="127.0.0.1" port="5028" framing="LfTerminated" />
    <TcpSerial deviceId="PSU_RF1" bindAddress="127.0.0.1" port="5029" framing="LfTerminated" />
    <TcpSerial deviceId="PSU_RF2" bindAddress="127.0.0.1" port="5030" framing="LfTerminated" />
    <TcpSerial deviceId="TC1" bindAddress="127.0.0.1" port="5031" framing="LfTerminated" />
    <TcpSerial deviceId="Holder" bindAddress="127.0.0.1" port="5032" framing="LfTerminated" />
    <TcpSerial deviceId="Shutter" bindAddress="127.0.0.1" port="5033" framing="LfTerminated" />
  </Protocols>
  <Physics noiseStddev="0.02">
    <TurboSpinUpTime>30</TurboSpinUpTime>
    <TurboCrossoverPressure>0.5</TurboCrossoverPressure>
    <MfcResponseTau>0.5</MfcResponseTau>
    <SubstrateHeatingCoeff>0.002</SubstrateHeatingCoeff>
    <SubstrateCoolingCoeff>0.005</SubstrateCoolingCoeff>
    <DischargePressureThreshold>0.001</DischargePressureThreshold>
    <Deposition reactiveMfc="N21" ratePerAmp="1.0" poisonRate="0.00673" cleanRate="0.1" poisonedRateFraction="0.2" poisonedVoltageShift="100" />
    <Magnetrons>
      <Magnetron id="MAG1" voltage="400" />
      <Magnetron id="MAG2" voltage="400" />
      <Magnetron id="MAG3" voltage="350" />
      <Magnetron id="MAG4" voltage="1000" />
      <Magnetron id="MAG5" voltage="400" />
      <Magnetron id="MAG6" voltage="350" />
    </Magnetrons>
    <Chamber id="Main" type="Process">
      <InitialPressure>1E-2</InitialPressure>
      <Volume>750</Volume>
      <BasePressure>1E-7</BasePressure>
      <LeakRate>1E-6</LeakRate>
      <PumpdownTau>5.0</PumpdownTau>
    </Chamber>
    <Chamber id="Loadlock" type="Loadlock">
      <InitialPressure>760</InitialPressure>
      <Volume>20</Volume>
      <BasePressure>5E-4</BasePressure>
      <LeakRate>1E-5</LeakRate>
      <PumpdownTau>3.0</PumpdownTau>
    </Chamber>
  </Physics>
</EmulatorConfig>
